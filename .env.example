# Postgres database name
POSTGRES_DB=wtf_livepulse
# Postgres username
POSTGRES_USER=wtf
# Postgres password (override this in real deployments)
POSTGRES_PASSWORD=wtf_secret
# Full connection string the backend uses to reach Postgres
DATABASE_URL=postgres://wtf:wtf_secret@db:5432/wtf_livepulse
# Port the backend Express server listens on
PORT=3001
# Node environment (development | test | production)
NODE_ENV=development
# Timezone used by the backend process and Postgres sessions
TZ=Asia/Kolkata
# Whether the data simulator job starts automatically on boot
SIMULATOR_AUTOSTART=false
# Interval, in ms, between anomaly-detector job ticks
ANOMALY_INTERVAL_MS=30000
# Frontend: API base URL override; empty = same origin (proxied via nginx)
VITE_API_BASE=
# Frontend: WebSocket URL override; empty = derive from window.location
VITE_WS_URL=
# Frontend e2e tests: base URL of the running stack
E2E_BASE_URL=http://localhost:3000
